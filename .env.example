# ===== LLM =====
API_KEY=sk-...                 # OpenAI API 키 (OPENAI_API_KEY도 가능)
LLM_MODEL=gpt-4o-mini

# ===== 인증 / 보안 =====
JWT_SECRET_KEY=                # 임의의 긴 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
ENCRYPTION_KEY=                # Notion 토큰 암호화용 Fernet 키 (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")

# ===== 서버 배포 (docker-compose.prod.yml) =====
# DOMAIN=quiz.example.com      # 서버에 연결한 도메인 (https:// 없이)
# POSTGRES_PASSWORD=           # DB 비밀번호 (긴 임의 문자열)

# ===== DB =====
# 미설정 시 로컬 SQLite(quiznote.db). docker compose에서는 PostgreSQL로 자동 설정됩니다.
# DATABASE_URL=postgresql+psycopg://quiznote:quiznote@localhost:5432/quiznote

# ===== 문서 처리 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
USE_EMBEDDINGS=true
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
PASS_SCORE=70
MAX_UPLOAD_MB=30

# ===== Notion OAuth (Public Integration) =====
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/notion/oauth/callback
FRONTEND_URL=http://localhost:8501
# 서버 배포 시: NOTION_REDIRECT_URI=https://<DOMAIN>/notion/oauth/callback
#              FRONTEND_URL=https://<DOMAIN>
#              CORS_ORIGINS=https://<DOMAIN>

# ===== 프런트엔드(Streamlit) → 백엔드 주소 =====
BACKEND_URL=http://127.0.0.1:8000
